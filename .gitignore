```gitignore
# Compiled and binary files
*.pyc
__pycache__/

# Dependencies
.venv/
venv/
node_modules/

# Logs and temporary files
*.log
*.tmp
*.swp
*.swo

# Environment variables
.env
.env.local
*.env.*

# Editors and IDEs
.vscode/
.idea/

# Build artifacts
dist/
build/
target/
*.o
*.obj
*.out

# Coverage reports
coverage/
htmlcov/
.coverage

# Python specific
.mypy_cache/
.pytest_cache/

# System files
.DS_Store
Thumbs.db
```